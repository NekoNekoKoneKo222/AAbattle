PORT=3000
# 本番では既存のNeon接続文字列を維持してください。ローカル試験は未設定でメモリ保存です。
DATABASE_URL=
# ollama / gemini / local。未設定時は既存仕様（Geminiキーありならgemini、なしならlocal）
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
# 第2段階: Render側だけで設定するHTTPSの固定ホスト名。ローカルでは空欄。
OLLAMA_GATEWAY_URL=
# 同じ秘密トークンをRenderとPCゲートウェイに設定する。値はコミットしない。
OLLAMA_GATEWAY_TOKEN=
# Cloudflare Access Service Token。Render側だけで設定する。
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Geminiを使う場合のみ設定。秘密情報をコミットしないでください。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
